{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/web/**/*",
      "apps/extensions/**/*",
      "services/api/**/*",
      "packages/browser-core/**/*",
      "packages/agent-runtime/**/*",
      "packages/sdk/**/*",
      "pnpm-lock.yaml",
      "Dockerfile",
      "Caddyfile",
      "start.sh",
      "*.svg",
      "*.png",
      "railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
